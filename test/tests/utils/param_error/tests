[Tests]
  issues = '#16410'
  design = utils/InputParameters.md
  [error]
    type = RunException
    input = param_error.i
    expect_err = "param_error.i:10.3:(.*)missing required parameter 'Kernels/diffusion/D'"

    requirement = "The system shall automatically report input errors when a required parameter is not specified."
  []
  [threaded_error]
    type = RunException
    input = threaded_param_error.i
    min_threads = 2
    max_threads = 2
    expect_err = "threaded_param_error.i:20.5:(.*)Intentional threaded paramError from computeValue"

    requirement = "The system shall report parameter errors from threaded execution paths."
  []
[]
